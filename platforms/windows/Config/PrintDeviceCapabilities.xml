  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:mdvp="https://ao-jeferson.github.io/markdown-virtual-printer/print-schema">
  <psf:Feature name="mdvp:KeepFormatting">
    <psf:Property name="psf:SelectionType"><psf:Value xsi:type="xsd:string">PickOne</psf:Value></psf:Property>
    <psf:Option name="mdvp:On" />
